# Server
PORT=4000
NODE_ENV=development

# Ma'lumotlar bazasi.
# Dev uchun SQLite (sozlashsiz ishlaydi). Prod uchun PostgreSQL'ga o'ting:
# DATABASE_URL="postgresql://user:pass@localhost:5432/ku?schema=public"
DATABASE_URL="file:./dev.db"

# JWT — ishlab chiqarishda ALBATTA o'zgartiring (uzun tasodifiy satr)
JWT_SECRET="dev-only-change-me-in-production"
JWT_EXPIRES_IN="30d"

# QR xarid tokeni necha daqiqadan keyin eskiradi
PURCHASE_QR_TTL_MINUTES=15
